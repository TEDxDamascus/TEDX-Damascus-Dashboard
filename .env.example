# Local dev (recommended): same-origin /api → Vite proxy → VITE_API_TARGET (avoids browser CORS).
VITE_API_URL=/api
VITE_API_TARGET=http://localhost:3000

# Alternative: call API directly (backend must send proper CORS headers).
# VITE_API_URL=http://localhost:3000

VITE_APP_NAME=TEDx Damascus Dashboard
